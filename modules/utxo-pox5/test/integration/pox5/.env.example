POX5_NETWORK=tbtcstxprivate1
# Use direct to run the package-owned Bitcoin Core Compose file without indexer-utxo.
POX5_FULLNODE_MODE=direct
# Required only when POX5_FULLNODE_MODE=indexer:
# POX5_INDEXER_UTXO_ROOT=/home/otto/src/BitGo/indexer-utxo
# POX5_BOND_INDEX is optional for the dashboard; live staking API tests require an explicit index.
# POX5_SIGNER_MANAGER is optional for tbtcstxprivate1 and defaults to the shared daemon contract.
# It is required for tbtcstx unless supplied by the deployment operator.
POX5_BITCOIN_RPC_USER=btcuser
POX5_BITCOIN_RPC_PASSWORD=btcpass
POX5_BITCOIN_RPC_URL=http://127.0.0.1:40443
POX5_STACKS_NODE_URL=https://api.private-1.hiro.so
POX5_STACKS_API_URL=https://api.private-1.hiro.so
STACKS_JS_ROOT=/home/otto/src/BitGo/stacks.js-pox5
POX5_STACKS_JS_COMMIT=6101c99efe5a9616ce7e16cef68e28fd10676e7e
POX5_STACKS_STAKER_ADDRESS=
POX5_STACKS_PRIVATE_KEY=
POX5_BOND_INDEX=
POX5_SIGNER_MANAGER=
POX5_UNLOCK_HEIGHT=
POX5_AMOUNT_SATS=30000

# Opt-in only: exercise Wallet Platform hot or custodial PoX-5 signing without
# broadcasting. Hot mode requires an allowlisted STX wallet, bond index, and signer
# manager; custodial mode uses tx/initiate and a pending approval.
# POX5_ENABLE_LIVE_WP_SIGNING=1
# POX5_WP_SIGN_WALLET_TYPE=hot
# POX5_BITGO_API_ENV=staging
# POX5_BITGO_STAKING_AMOUNT_SATS=30000
# POX5_STX_AMOUNT_USTX=10000000
# POX5_STX_WALLET_ID=

# Optional isolated wallet label for fake-stake integration runs.
# POX5_FAKE_STAKE_WALLET_LABEL=pox5-fake-stake-tbtcstx-isolated

# Switch to the public profile with:
# POX5_NETWORK=tbtcstx
# POX5_BITCOIN_RPC_URL=http://127.0.0.1:18443
# POX5_STACKS_NODE_URL=https://api.testnet.hiro.so
# POX5_STACKS_API_URL=https://api.testnet.hiro.so

# Deterministic disposable profile only:
# POX5_NETWORK=local
# STACKS_CORE_ROOT=/home/otto/src/BitGo/stacks-core
# STACKS_REGTEST_ENV_ROOT=/home/otto/src/BitGo/stacks-regtest-env
