POX5_NETWORK=tbtcstxprivate1
# Use direct to run the package-owned Bitcoin Core Compose file without indexer-utxo.
POX5_FULLNODE_MODE=direct
# Required only when POX5_FULLNODE_MODE=indexer:
# POX5_INDEXER_UTXO_ROOT=/home/otto/src/BitGo/indexer-utxo
# POX5_BOND_INDEX is required for live Wallet Platform signing tests.
# POX5_SIGNER_MANAGER is optional for tbtcstxprivate1 and defaults to the shared daemon contract.
# It is required for tbtcstx unless supplied by the deployment operator.
POX5_BITCOIN_RPC_USER=btcuser
POX5_BITCOIN_RPC_PASSWORD=btcpass
POX5_BITCOIN_RPC_URL=http://127.0.0.1:40443
POX5_STACKS_NODE_URL=https://api.private-1.hiro.so
POX5_STACKS_API_URL=https://api.private-1.hiro.so
STACKS_JS_ROOT=/home/otto/src/BitGo/stacks.js-pox5
POX5_STACKS_JS_COMMIT=6101c99efe5a9616ce7e16cef68e28fd10676e7e
POX5_STACKS_STAKER_ADDRESS=
POX5_STACKS_PRIVATE_KEY=
POX5_BOND_INDEX=
POX5_SIGNER_MANAGER=
POX5_UNLOCK_HEIGHT=
POX5_AMOUNT_SATS=30000

# Opt-in: create or verify fixed-script hot wallets on each supported testnet.
# This does not fund the wallets or submit transactions.
# POX5_ENABLE_LIVE_WALLET_CREATION=1
# POX5_BITGO_API_ENV=staging
# POX5_BITGO_ENTERPRISE_ID=

# The faucet-only integration covers every supported tbtcstx* coin by default;
# set POX5_NETWORK to one coin to narrow the run. Set POX5_BITGO_API_ENV to test
# or staging to select the matching BitGo credentials and enterprise.
# POX5_NETWORK=tbtcstxsignet
# POX5_BITGO_API_ENV=staging
# POX5_BITGO_ENTERPRISE_ID_STAGING=
# POX5_BITGO_ENTERPRISE_ID_TEST=
# Force a fresh deposit into the dedicated funding wallet when it is already funded.
# POX5_FUND_FORCE_FAUCET=1

# Opt-in only: exercise Wallet Platform hot or custodial PoX-5 signing without
# broadcasting. Hot mode requires an allowlisted STX wallet, bond index, and signer
# manager; custodial mode uses tx/initiate and a pending approval.
# POX5_ENABLE_LIVE_WP_SIGNING=1
# POX5_WP_SIGN_WALLET_TYPE=hot
# POX5_BITGO_API_ENV=staging
# POX5_BITGO_STAKING_AMOUNT_SATS=30000
# POX5_STX_AMOUNT_USTX=10000000
# POX5_STX_WALLET_ID=

# Optional isolated wallet label for fake-stake integration runs.
# POX5_FAKE_STAKE_WALLET_LABEL=pox5-fake-stake-tbtcstx-isolated

# Opt-in standalone PoX-5 descriptor-wallet round trip. Creates a dedicated
# hot descriptor wallet plus a dedicated fixed-script main wallet, funds the
# main wallet from the Hiro BTC faucet, sends to a PoX-5 receive address,
# then sweeps the matured lockup back to the main wallet through Wallet
# Platform signing. Broadcasts real transactions on the shared test network.
# POX5_ENABLE_LIVE_DESCRIPTOR_SPEND=1
# POX5_DESCRIPTOR_WALLET_LABEL=pox5-descriptor-spend-tbtcstx
# POX5_DESCRIPTOR_MAIN_WALLET_LABEL=pox5-descriptor-main-tbtcstx

# Switch to the public profile with:
# POX5_NETWORK=tbtcstx
# POX5_BITCOIN_RPC_URL=http://127.0.0.1:18443
# POX5_STACKS_NODE_URL=https://api.testnet.hiro.so
# POX5_STACKS_API_URL=https://api.testnet.hiro.so

# Deterministic disposable profile only:
# POX5_NETWORK=local
# STACKS_CORE_ROOT=/home/otto/src/BitGo/stacks-core
# STACKS_REGTEST_ENV_ROOT=/home/otto/src/BitGo/stacks-regtest-env

# Dedicated PoX-5 live matrix. Export these separately for the explicit live
# command; unit tests never load this configuration. Do not commit real secrets.
# BITGO_TOKEN_TEST=
# BITGO_TOKEN_STAGING=
# BITGO_APPROVER_TOKEN_TEST=
# BITGO_APPROVER_TOKEN_STAGING=
# BITGO_CUSTODYADMIN_TOKEN_TEST= (from the custodyadmin user session file; the
# upload actor must be distinct from the policy approver)
# BITGO_CUSTODYADMIN_TOKEN_STAGING=
# Test-environment OTP for the SDK unlock and Wallet Platform approvals (take it
# from your secret store); the per-environment variables below override it.
# BITGO_TEST_OTP=
# POX5_LIVE_UNLOCK_OTP_TEST=
# POX5_LIVE_UNLOCK_OTP_STAGING=
# POX5_LIVE_APPROVER_OTP_TEST=
# POX5_LIVE_APPROVER_OTP_STAGING=
# POX5_LIVE_ENTERPRISE_TEST=
# POX5_LIVE_ENTERPRISE_STAGING=
# Hot-wallet passphrase: BITGO_WALLET_PASSPHRASE for all environments, or per environment:
# BITGO_WALLET_PASSPHRASE=
# BITGO_WALLET_PASSPHRASE_TEST=
# BITGO_WALLET_PASSPHRASE_STAGING=
# Optional stable recovery-seed overrides. Fresh fixtures default to the
# effective wallet passphrase; keep an override stable when reusing descriptors.
# POX5_LIVE_RECOVERY_SEED_TEST=
# POX5_LIVE_RECOVERY_SEED_STAGING=
# STACKS_JS_ROOT= (pinned, built stacks.js-pox5 checkout)
# POX5_LIVE_REPORT=/tmp/kilo/pox5-live-controlled.json

# Opt-in custodial offline signing via the OVC sign-export CLI. The CLI lives in
# the offline-vault-console checkout (scripts/sign-export.ts, stacked on the
# PoX-5 late-exit work) and runs in OVC's own dependency tree and Node version;
# the harness only sees its JSON contract.
#   default: custodial cells stay BLOCKED awaiting the offline signature
#   POX5_LIVE_OVC_SIGN=true: fetch the export, OVC-sign it, cross-check the
#     explanation against the inspected PSBT, then BLOCK before uploading
#   POX5_LIVE_OVC_UPLOAD=true (requires SIGN): upload the half-signed
#     transaction via the custodyadmin session and broadcast
# POX5_LIVE_OVC_SIGN=
# POX5_LIVE_OVC_UPLOAD=
# Path to the offline-vault-console checkout (repo root) that includes the CLI.
# POX5_OVC_DIR=
# Optional runner prefix; the harness appends `sign-export <mode> ...`.
# POX5_OVC_COMMAND=fnm exec --using=24.15.0 yarn
# Optional key file override (defaults to the OVC test custody key).
# POX5_OVC_KEY_FILE=
# OVC test custody key password; handed to the CLI via env, never via argv.
# POX5_OVC_KEY_PASSWORD=
# POX5_OVC_TIMEOUT_MS=120000
POX5_LIVE_STAKE_SATS=30000
POX5_LIVE_MAX_STAKE_SATS=30000
POX5_LIVE_MAX_FEE_SATS=5000
POX5_LIVE_MAX_FAUCET_SATS=100000000
POX5_LIVE_MAX_RECOVERY_SATS=100000000
POX5_LIVE_MAX_LOCK_BLOCKS=100000
# Polling/confirmation timeout. Since the 2026-10 chain reset, tbtcstxsignet produces
# blocks on a ~2-minute cadence (pre-reset docs assumed ~10 minutes); that pace holds only
# until the first 2016-block difficulty adjustment, after which it converges toward ~600 s.
# Use at least 7200000 (2 h) for a generous margin in both regimes (see
# modules/utxo-pox5/README.md#signet-block-schedule). Unset defaults to
# 7200000 for tbtcstxsignet and 1200000 for the regtest coins.
POX5_LIVE_TIMEOUT_MS=1200000
POX5_LIVE_PACE_MS=2000
POX5_LIVE_FEE_RATE=1000
# POX5_LIVE_BOND_INDEX_TBTCSTX=
# POX5_LIVE_BOND_INDEX_TBTCSTXPRIVATE1=
# POX5_LIVE_BOND_INDEX_TBTCSTXSIGNET=
# Read-only discovery on 2026-10-09 found signet bond 325 open (recheck before use).
# POX5_LIVE_BOND_INDEX_TBTCSTXSIGNET=325
# Optional override for an existing nonzero paired Pox5Lockup descriptor index.
# Fresh paired descriptors default to index 0 and are checked against the PSBT.
# POX5_LIVE_PAIRED_DESCRIPTOR_INDEX_TEST_TBTCSTX_HOT=
# POX5_LIVE_PAIRED_INPUT_OUTPOINT_TEST_TBTCSTX_HOT=
# POX5_LIVE_STANDALONE_INPUT_OUTPOINT_TEST_TBTCSTX_HOT=
# POX5_LIVE_PAIRED_RECOVERY_OUTPOINT_TEST_TBTCSTX_HOT=
# Optional assertion; paired post-CLTV recovery discovers the index from the
# confirmed unspent and verifies it via BitGo getAddress.
# POX5_LIVE_PAIRED_RECOVERY_DESCRIPTOR_INDEX_TEST_TBTCSTX_HOT=
# Pin the recovery unlock height when the paired wallet carries lockups from
# several bonds (one descriptor per unlock height, e.g. after reusing the fixture
# wallet across bonds); the pinned height must match exactly one descriptor.
# Unset, the paired wallet must carry exactly one descriptor.
# POX5_LIVE_PAIRED_RECOVERY_UNLOCK_HEIGHT_TEST_TBTCSTX_HOT=
# POX5_LIVE_STANDALONE_DESCRIPTOR_WALLET_ID_TEST_TBTCSTX_HOT=
# POX5_LIVE_STANDALONE_RECOVERY_OUTPOINT_TEST_TBTCSTX_HOT=
# POX5_LIVE_STANDALONE_RECOVERY_UNLOCK_HEIGHT_TEST_TBTCSTX_HOT=
# The fixture suffix above is <TEST|STAGING>_<TBTCSTX|TBTCSTXPRIVATE1|TBTCSTXSIGNET>_<HOT|CUSTODIAL>.
# Optional endpoint overrides must retain the network-matched HTTPS origin.
# POX5_LIVE_BTC_API_TBTCSTXSIGNET=https://mempool.bitcoin.staking-testnet.hiro.so/api
# POX5_LIVE_STACKS_URL_TBTCSTXSIGNET=https://api.staking-testnet.hiro.so
