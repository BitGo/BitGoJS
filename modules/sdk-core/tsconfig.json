{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./",
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "typeRoots": ["../../types", "./node_modules/@types", "../../node_modules/@types"]
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "test/unit/bitgo/safe/fixtures/derivableEd25519Pub.json",
